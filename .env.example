# Ox Factory optional local environment.
# Copy to `.env` only for your own shell/run scripts. Do not commit real tokens.

# Codex app-server backend (optional; Pi backend does not need this).
OX_CODEX_APP_SERVER_URL=ws://127.0.0.1:48177
OX_CODEX_APP_SERVER_CMD=codex

# Codex worker defaults. New Codex hires default to full access in code unless
# explicitly configured tighter at hire/config time.
OX_CODEX_SANDBOX=danger-full-access
OX_CODEX_APPROVAL_POLICY=never

# Codex shadow compaction (optional).
# shadow = evaluate Codex summary but keep Pi's original compaction result.
OX_FACTORY_CODEX_COMPACTION_MODE=shadow
# OX_FACTORY_CODEX_COMPACTION_WORKERS=东子,布朗尼
OX_FACTORY_CODEX_COMPACTION_MODEL=gpt-5.5

# Main agent label used in compaction reports.
OX_FACTORY_MAIN_AGENT_NAME=主agent
